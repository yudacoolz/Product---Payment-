// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// schema.prisma

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  jumlah      Int      @default(0) // stock quantity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Order {
  order_id         String         @id @default(uuid())
  status     OrderStatus @default(PENDING)
  gross_amount Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // if you have users/auth later
  // userId  Int
  // user    User      @relation(fields: [userId], references: [id])

  items OrderItem[]
  payment_type String @default("unknown")
  payment_name String @default("unknown")
}

model OrderItem {
  orderItemid        Int   @id @default(autoincrement())
  jumlah    Int   
  price     Float 

  order_id   String
  order     Order   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([order_id, productId]) // prevent duplicate rows for same product in one order
}

model Cart {
  cartId        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // userId  Int      @unique  // one active cart per user, if you have auth
  // user    User     @relation(fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  cartItemId        Int @id @default(autoincrement())
  jumlah    Int 

  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId]) 
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}